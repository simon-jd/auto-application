[Unit]
OnFailure=auto-app-alert@%n.service
Description=Job Search MCP tools
After=network.target

# A persistent failure must reach the failed state so OnFailure alerts: configuration errors
# exit 2 and are not retried; any other crash loop stops after 10 starts in 30 minutes.
StartLimitIntervalSec=1800
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/Desktop/job-search/auto-application
ExecStart=%h/Desktop/job-search/auto-application/.venv/bin/auto-app-agent serve --db %h/Desktop/job-search/runtime/data/auto_app.db --preferences %h/Desktop/job-search/runtime/config/preferences.json --preparation-dir %h/Desktop/job-search/runtime/preparation --transport streamable-http --host 127.0.0.1 --port 8767 --control-tools
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
