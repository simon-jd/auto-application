# Fill these four values on Linux only. Use raw values, without quotes or export.
# The actual credentials/bot.env must be a regular file with mode 0600.
AUTO_APP_DISCORD_BOT_TOKEN=
AUTO_APP_DISCORD_OWNER_ID=
AUTO_APP_DISCORD_GUILD_ID=
AUTO_APP_DISCORD_CHANNEL_ID=
# Optional (2026-11-18): the channel for Claude's questions to you; without it they go to the channel above.
# AUTO_APP_DISCORD_QUESTIONS_CHANNEL_ID=
