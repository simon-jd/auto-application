[Unit]
OnFailure=auto-app-alert@%n.service
Description=Job Search MCP tools (token-protected, for the public tunnel)
After=network.target
ConditionPathExists=%h/Desktop/job-search/runtime/config/grok.env
ConditionPathExists=%h/Desktop/job-search/runtime/credentials/mcp-token

# A persistent failure must reach the failed state so OnFailure alerts: configuration errors
# exit 2 and are not retried; any other crash loop stops after 10 starts in 30 minutes.
StartLimitIntervalSec=1800
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/Desktop/job-search/auto-application
EnvironmentFile=%h/Desktop/job-search/runtime/config/grok.env
ExecStart=%h/Desktop/job-search/auto-application/.venv/bin/auto-app-agent serve --db %h/Desktop/job-search/runtime/data/auto_app.db --preferences %h/Desktop/job-search/runtime/config/preferences.json --transport streamable-http --host 127.0.0.1 --port 8769 --auth-token-file %h/Desktop/job-search/runtime/credentials/mcp-token --public-url ${AUTO_APP_MCP_PUBLIC_URL} --control-tools
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
